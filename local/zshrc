# Use vim as the visual editor
export VISUAL='vim'
export EDITOR=$VISUAL

# Path to my oh-my-zsh configuration.
export ZSH=$HOME/.oh-my-zsh

BASE="$HOME/.zsh"
for file in "$BASE/"*.zsh; do
  source "$file"
done

ZSH_THEME="robbyrussell"
test -f ~/.oh-my-zsh/custom/themes/elena.zsh-theme && ZSH_THEME="elena"

# Chruby (hardcoded brew prefix — saves ~160ms vs `brew --prefix`)
source /opt/homebrew/opt/chruby/share/chruby/chruby.sh
source /opt/homebrew/opt/chruby/share/chruby/auto.sh
chruby ruby-3.3.0

# Yarn (cached path — run `yarn global bin` to verify if yarn moves)
export PATH="$PATH:$HOME/.yarn/bin"

# NVM (lazy-loaded — saves ~550ms, initializes on first nvm/node/npm call)
export NVM_DIR="$HOME/.nvm"
nvm() { unset -f nvm node npm npx; [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"; nvm "$@"; }
node() { unset -f nvm node npm npx; [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"; node "$@"; }
npm() { unset -f nvm node npm npx; [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"; npm "$@"; }
npx() { unset -f nvm node npm npx; [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"; npx "$@"; }

FPATH=/opt/homebrew/share/zsh/site-functions:$FPATH

# goenv (lazy-loaded — saves ~476ms, initializes on first goenv/go call)
export GOENV_ROOT="$HOME/.goenv"
export PATH="$GOENV_ROOT/bin:$PATH"
goenv() { unset -f goenv; eval "$(command goenv init -)"; goenv "$@"; }

# Go
export PATH="$GOROOT/bin:$PATH"
export PATH="$PATH:$GOPATH/bin"

# Pyenv (lazy-loaded — saves ~190ms)
pyenv() { unset -f pyenv; eval "$(command pyenv init -)"; pyenv "$@"; }
python() { unset -f pyenv python python3; eval "$(command pyenv init -)"; python "$@"; }
python3() { unset -f pyenv python python3; eval "$(command pyenv init -)"; python3 "$@"; }

# Fuzzy finder
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# Added by serverless binary installer
export PATH="$HOME/.serverless/bin:$PATH"

# Sync with vars set in .zshenv
. ~/.zshenv

# Start the ssh agent
[ -z "$SSH_AUTH_SOCK" ] && eval "$(ssh-agent -s)"

# Reload
source $ZSH/oh-my-zsh.sh
export JETBRAINS_LICENSE_SERVER=https://github.jetbrains-ide-services.com

# Auto-update codespace SSH config (fully backgrounded to avoid blocking shell startup)
if command -v gh >/dev/null 2>&1; then
  {
    if gh codespace list --json name --jq '.[0].name' >/dev/null 2>&1; then
      config_file="$HOME/.ssh/codespaces_config"
      if [ ! -f "$config_file" ] || [ -n "$(find "$config_file" -mmin +60 2>/dev/null)" ]; then
        cssh-config >/dev/null 2>&1
      fi
    fi
  } &!
fi
